{
  "dependencies": {
    "madden-franchise": "^4.3.5"
  },
  "description": "CFB27 real-life force-win: mirror actual college football results via SeasonGame.ForceWin",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "name": "cfb27-force-win",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "build:exe": "pkg dist/bootstrap.js --target node18-win-x64 --output ../release/CFB27-ForceWin.exe"
  },
  "type": "module",
  "version": "0.1.0"
}